# Local development against `docker compose up -d postgres redis`.
# Copy to .env and `set -a; source .env; set +a` before `go run ./cmd/api` / `./cmd/worker`.
# All values are local demo placeholders; never commit real credentials.

APP_ENV=development
LOG_LEVEL=info
API_KEY=dev-local-key
ENABLE_PPROF=false

POSTGRES_DSN=postgres://ordersync:ordersync@localhost:5433/ordersync?sslmode=disable
POSTGRES_MAX_CONNS=20
REDIS_ADDR=localhost:6380

# api
HTTP_ADDR=:8080
IDEMPOTENCY_TTL=24h
MOCK_MARKET_ENABLED=true
MOCK_FAIL_RATE=0.05
MOCK_LATENCY=25ms

# worker
METRICS_ADDR=:8081
# WORKER_ID defaults to the hostname; set it when running several workers on one host.
POLL_INTERVAL=1s
MAX_CONCURRENCY=16
BATCH_MIN=5
BATCH_SOFT_LIMIT=40
BATCH_MAX=200
MAX_BATCHES_PER_JOB=50
ORDER_LEASE=2m
ORDER_TIMEOUT=30s
JOB_LEASE=1m
MAX_ATTEMPTS=5
RETRY_BASE=2s
RETRY_MAX=5m
LEADER_TTL=10s
SHUTDOWN_GRACE=20s
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=200
OUTBOX_RETENTION=72h

# Mock marketplace endpoints and per-marketplace request budgets.
MARKET_BASE_URL=http://localhost:8080/mock/marketplaces
WB_LIKE_TOKEN=demo-wb-token
OZON_LIKE_TOKEN=demo-ozon-token
WB_LIKE_RPS=20
OZON_LIKE_RPS=30

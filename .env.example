APP_ENV=development
HTTP_ADDR=:8080
API_KEY=dev-local-key
POSTGRES_DSN=postgres://ordersync:ordersync@localhost:5433/ordersync?sslmode=disable
REDIS_ADDR=localhost:6380
REDIS_DB=0
WORKER_ID=local-worker
WORKER_METRICS_ADDR=:8081
POLL_INTERVAL=2s
MAX_CONCURRENCY=8
LOCK_TTL=30s
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
BATCH_MIN=5
BATCH_MAX=100
BATCH_SOFT_LIMIT=40
WB_LIKE_RPS=5
OZON_LIKE_RPS=8
MOCK_FAIL_PCT=0.08
ENABLE_PPROF=true
MIGRATIONS_PATH=migrations/001_init.sql

      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ordersync_order_sync_duration_seconds_bucket[1m])))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ordersync_order_sync_duration_seconds_bucket[1m])))",
          "refId": "B",
          "legendFormat": "p95"
        }
      ]
